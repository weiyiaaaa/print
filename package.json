{
  "name": "print-plugin-unified",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.js",
    "test": "npm run verify && node scripts/test_table_switch.js",
    "check": "npm run typecheck && npm test && npm run build",
    "serve": "node server/serve.cjs 8666",
    "serve:build": "npm run build && node server/serve.cjs 8666",
    "package": "npm run build && node scripts/package.js",
    "preupload": "node scripts/prepare-upload.js",
    "upload": "npm run build && node scripts/prepare-upload.js && opdev upload ./dist"
  },
  "dependencies": {
    "@lark-base-open/js-sdk": "^1.0.2",
    "@lark-opdev/block-bitable-api": "^0.4.1-alpha.11",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "html-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
